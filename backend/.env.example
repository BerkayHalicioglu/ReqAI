# PostgreSQL connection
DATABASE_URL=postgresql://reqai_user:reqai_pass@localhost:5432/reqai_db

# Set to "true" to use the mock AI service instead of real OpenAI calls
USE_MOCK_AI=true

# Only needed if USE_MOCK_AI=false
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Where uploaded TXT files are stored on disk
UPLOAD_DIR=./uploads
